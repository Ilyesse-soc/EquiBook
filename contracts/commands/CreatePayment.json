{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatePayment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "commandType",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "commandType": {
      "const": "CreatePayment"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookingId"
      ],
      "properties": {
        "bookingId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
