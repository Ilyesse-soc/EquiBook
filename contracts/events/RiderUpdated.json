{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiderUpdated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "emitterService",
    "receivers",
    "aggregateId",
    "aggregateVersion",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "RiderUpdated"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "emitterService": {
      "const": "rider-service"
    },
    "receivers": {
      "const": [
        "booking-service",
        "dashboard-service"
      ]
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riderId",
        "firstName",
        "lastName",
        "email",
        "phone",
        "level",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "riderId": {
          "type": "string",
          "format": "uuid"
        },
        "firstName": {
          "type": "string",
          "minLength": 1
        },
        "lastName": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "BEGINNER",
            "GALOP_1",
            "GALOP_2",
            "GALOP_3",
            "GALOP_4",
            "GALOP_5",
            "GALOP_6",
            "GALOP_7"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
